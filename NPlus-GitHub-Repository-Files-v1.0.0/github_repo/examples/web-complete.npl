// N+ Web v0.3 — full development server demo
web.host("127.0.0.1")*
web.listen(3000)*

web.get("/", "<!doctype html><html><head><meta charset="utf-8"><title>N+ Web</title></head><body><main><h1>Welcome to N+ Web</h1><p>HTML routes, JSON APIs and static assets in one N+ project.</p><a href="/about">About</a></main></body></html>")*

web.get("/about", "<!doctype html><html><body><h1>About</h1><p>This page is served by an N+ route.</p></body></html>")*

web.get("/api/status", "{\"ok\":true,\"language\":\"N+\",\"version\":\"0.3.0\"}")*

web.static("../examples/web-site")*

web.start()!
